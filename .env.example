# EevaResearch AI — environment configuration
# Copy this file to .env and adjust as needed. Nothing here is required to run in mock mode.

# Data mode: "mock" (default, no external calls/keys needed) or "live"
# "live" activates real SEC EDGAR fundamentals/filings for US tickers — see README
# "Data Provider Integration Guide" for what's live vs. still mock.
EDGE_DATA_MODE=mock

# SQLite database file path (created automatically on first run)
EDGE_DB_PATH=data/edge_research.db

# Default freshness thresholds (days) used to flag stale evidence
EDGE_FRESHNESS_FRESH_DAYS=30
EDGE_FRESHNESS_AGING_DAYS=60
EDGE_FRESHNESS_STALE_DAYS=90

# Cost-control limits (see guardrails principle #10)
EDGE_MAX_SOURCES_PER_BRIEF=12
EDGE_MAX_EXCERPTS_PER_SOURCE=5

# --- Live-mode provider keys (NOT required in mock mode; leave blank until you wire a live provider) ---
# SEC EDGAR requires no key, only a compliant User-Agent string identifying you:
EDGE_SEC_USER_AGENT="Your Name your.email@example.com"

# Optional live fundamentals / market data providers (examples — add whichever you actually integrate)
# EDGE_FUNDAMENTALS_API_KEY=
# EDGE_MARKET_DATA_API_KEY=
# EDGE_NEWS_API_KEY=

# Non-US filings — NOT implemented yet (see README "Filings beyond the US" for why:
# both need you to register a free account yourself, EDINET with a phone number and
# DART with email verification). Env var names are reserved so the future
# implementation has somewhere to read them from.
# EDGE_EDINET_API_KEY=
# EDGE_DART_API_KEY=

# Optional: only needed if you later enable the optional LLM narrative-polish hook (off by default)
# ANTHROPIC_API_KEY=

# --- Radar (autonomous scanner) — a separate feature from everything above ---
# Required only if you run scripts/run_radar_scan.py locally. In production this
# is set as a GitHub Actions repository secret, NOT in this file — see README
# "Radar" section. Radar makes zero LLM calls without this key set.
# ANTHROPIC_API_KEY=

# Optional: caps how many candidate items get an LLM call per scan run (cost control)
# EDGE_RADAR_MAX_ITEMS_PER_RUN=25

# Optional: max age (hours) of a feed item before Radar drops it, unseen. Items with
# no parseable publish date are dropped too, regardless of this setting.
# EDGE_RADAR_MAX_AGE_HOURS=24

# Optional: a Slack/Discord/Mattermost incoming webhook URL. When set, Radar posts
# a one-message digest of each run's new findings. NOT filtered to your Watchlist —
# see README "Radar" section for why. In production this is a GitHub Actions repo
# secret (EDGE_RADAR_WEBHOOK_URL), not this file.
# EDGE_RADAR_WEBHOOK_URL=
